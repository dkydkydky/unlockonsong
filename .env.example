# Only secret needed -- or rely on ~/.zero/config.json from `zero init`
ZERO_PRIVATE_KEY=0x_your_private_key_here

# (Optional) Zero capability identifiers to enable real CLI calls
# Set these to the capability IDs you discover via `zero search` / `zero get`.
ZERO_ANALYZE_CAPABILITY=your-image-analysis-capability-id
ZERO_GENERATE_CAPABILITY=your-music-generation-capability-id
